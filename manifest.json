{
  "manifest_version": 3,
  "name": "Claim Amount Auto-Fill",
  "version": "1.5.0",
  "description": "Fills approved amounts from claim amounts and audits bundled RGHS packages for unbundling and duplicate billing",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://rghs.rajasthan.gov.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "audit-rules.js",
        "audit-core.js",
        "claim-core.js",
        "review-core.js",
        "content.js",
        "floating-widget.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/claim-spark.png"
      ],
      "matches": [
        "https://rghs.rajasthan.gov.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
